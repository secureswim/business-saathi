      "typeVersion": 2,
      "position": [
        -600,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// idempotency key: a retried webhook must not create two campaigns\nconst b = $input.first().json.body || $input.first().json;\nreturn [{json: {run_id: b.run_id, merchant_id: b.merchant_id,\n  action_type: b.action_type, params: b.params || {},\n  situation_id: b.situation_id ?? null,\n  idempotency_key: b.run_id}}];"
      },
      "id": "normalise",
      "name": "Normalise",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -400,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://pennsylvania-arab-ist-scored.trycloudflare.com/api/internal/validate-action",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Saathi-Secret",
              "value": "saathi-demo-secret"
            }
          ]
        },
        "options": {
          "timeout": 20000,
          "retry": {
            "retry": {
              "maxTries": 2,
              "waitBetweenTries": 2000
            }
          }
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"run_id\": {{ JSON.stringify($json.run_id) }}}"
      },
      "id": "validate",
      "name": "Validate",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -200,
        300
