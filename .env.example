# Copy to .env and fill in the three secrets. config.py reads .env directly --
# no python-dotenv needed. Real environment variables override this file.
#
# Every adapter defaults to its fake implementation, and a clean clone still
# runs the whole demo offline with no keys -- it just answers through the
# deterministic path and labels itself `offline`. Supply one model key below
# and the agent takes over. Flip any other flag only after
# `python scripts/check_integrations.py` passes for that adapter.

# ---------- adapter flags ----------
SAATHI_REAL_COGNEE=1
SAATHI_REAL_SARVAM=1
SAATHI_REAL_N8N=1
SAATHI_REAL_LLM=1

# ---------- Cognee (managed tenant, REST) ----------
# The tenant runs the extraction model and embeddings itself: there is no
# model credential to supply.
COGNEE_API_KEY=
COGNEE_BASE_URL=https://tenant-<your-tenant>.aws.cognee.ai
COGNEE_TENANT_ID=
COGNEE_DATASET=paytm_hack
COGNEE_SEARCH_TYPE=CHUNKS
COGNEE_TOP_K=15

# ---------- Sarvam ----------
# saarika TRANSCRIBES; saaras TRANSLATES to English and would throw away the
# merchant's Hinglish. Verified against this account: saarika:v2.5 works,
# saarika:v2 and v1 are deprecated. bulbul:v3 speakers: aditya, ritu,
# ashutosh, priya, neha, rahul, pooja, rohan, simran.
SARVAM_API_KEY=
SARVAM_STT_MODEL=saarika:v2.5
SARVAM_STT_FALLBACK=saaras:v3
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_SPEAKER=priya
SARVAM_LANGUAGE=hi-IN

# ---------- n8n ----------
# n8n Cloud cannot reach 127.0.0.1, so PUBLIC_API_URL is the tunnel it calls
# back through:  cloudflared tunnel --url http://localhost:8000
N8N_BASE_URL=https://<your-instance>.app.n8n.cloud
N8N_API_KEY=
N8N_WEBHOOK_SECRET=saathi-demo-secret
PUBLIC_API_URL=
SAATHI_INTERNAL_SECRET=saathi-demo-secret

# ---------- the reasoning model ----------
# It plans, calls tools and decides when it has enough. It never does
# arithmetic, never touches SQL and never sets an action's parameters.
# Paste your key here, not into a chat window or a commit.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.2
OPENAI_BASE_URL=https://api.openai.com/v1

# auto = OpenAI, then Gemini, then NVIDIA NIM on failure.
# Also accepted: openai | gemini | nvidia | gemini-first | nvidia-first
SAATHI_LLM_PROVIDER=auto

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b

# ---------- the speaking model (optional) ----------
# `same` means the reasoning model also speaks: one call, one dependency.
# Set it to another configured provider to have that model write the spoken
# Hinglish from the same evidence -- useful if you want an Indic-tuned model
# on the voice while keeping structured output reliable on the reasoning.
# Whatever it writes still goes through the grounding gate.
SAATHI_SPEECH_PROVIDER=same
SAATHI_SPEECH_MODEL=

# ---------- agent loop ----------
SAATHI_AGENT_MAX_ROUNDS=4
SAATHI_AGENT_MAX_CALLS=10
SAATHI_AGENT_BUDGET_SECONDS=9
SAATHI_AGENT_REPAIR_ATTEMPTS=2
SAATHI_CONVERSATION_TURNS=10

# ---------- runtime ----------
SAATHI_DB=./data/saathi.db
SAATHI_PORT=8000

# ---------- demo tuning ----------
SIM_CLOCK_SECONDS_PER_DAY=20
MIN_COHORT_SIZE=5
SIMILARITY_THRESHOLD=0.85
EXTENDED_THRESHOLD=0.70
ALERT_DEVIATION_PCT=12
ALERT_SUPPRESSION_HOURS=24
DEMO_MERCHANT=M001
COLDSTART_MERCHANT=M999
